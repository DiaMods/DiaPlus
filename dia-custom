#!/bin/zsh
set -euo pipefail

project_dir="${0:A:h}"
command="${1:-help}"
(( $# == 0 )) || shift

case "$command" in
  build) exec "$project_dir/scripts/build.sh" "$@" ;;
  install) exec "$project_dir/scripts/install.sh" "$@" ;;
  launch) exec "$project_dir/scripts/launch.sh" "$@" ;;
  bridge) exec "$project_dir/scripts/launch.sh" --bridge-only "$@" ;;
  doctor) exec "$project_dir/scripts/doctor.sh" "$@" ;;
  test) exec "$project_dir/scripts/test.sh" "$@" ;;
  update) exec "$project_dir/scripts/build.sh" --replace "$@" ;;
  mods) exec node "$project_dir/scripts/mods.js" "$@" ;;
  modules) exec node "$project_dir/scripts/mods.js" "$@" ;;
  models)
    exec /usr/bin/curl --silent --show-error --fail \
      http://127.0.0.1:8765/api/models
    ;;
  settings)
    custom_app="${DIA_CUSTOM_APP:-${project_dir:h}/Dia Custom RTTM.app}"
    if [[ ! -d "$custom_app" ]]; then
      print -u2 "Dia Custom is not installed at $custom_app"
      exit 1
    fi
    exec /usr/bin/open -a "$custom_app" http://127.0.0.1:8765/settings
    ;;
  openai-key) exec "$project_dir/scripts/openai-key.sh" "$@" ;;
  status) exec /usr/bin/sed -n '1,240p' "$project_dir/docs/STATUS.md" ;;
  help|-h|--help)
    print 'Dia Custom'
    print ''
    print '  ./dia-custom launch             Start the local bridge and browser'
    print '  ./dia-custom bridge             Start only the local bridge'
    print '  ./dia-custom doctor             Check the installed clone'
    print '  ./dia-custom test               Run headless source and provider tests'
    print '  ./dia-custom models             Print the live provider catalog'
    print '  ./dia-custom settings           Open local model settings'
    print '  ./dia-custom openai-key         Configure OpenAI API access privately'
    print '  ./dia-custom install            Refresh patches in an existing clone'
    print '  ./dia-custom build [--replace]  Create a clone from /Applications/Dia.app'
    print '  ./dia-custom update             Rebuild only from an audited Dia app'
    print '  ./dia-custom mods               List or configure Dia Mods'
    print '  ./dia-custom status             Show implemented and remaining work'
    ;;
  *)
    print -u2 "Unknown command: $command"
    print -u2 "Run './dia-custom help' for available commands."
    exit 2
    ;;
esac
